rules_version = '2';
// TTESPL - SECURE firestore rules (use ONLY with Settings > Security > "Secure mode" ON and the functions/ gateway deployed).
// Every request must come from a signed-in staff member (token issued by the server login). Roles come from the token, not from the phone.
// Publish in Firebase console > Firestore > Rules (or: firebase deploy --only firestore:rules) AFTER you turned Secure mode on for every phone.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.role == 'Admin'; }

    // password / PIN hashes and login counters: only the server (Cloud Function) can touch these
    match /staff_secrets/{id} { allow read, write: if false; }
    match /login_guard/{id}   { allow read, write: if false; }

    match /staff/{id}            { allow read: if signedIn(); allow write: if isAdmin(); }
    match /perms/{id}            { allow read: if signedIn(); allow write: if isAdmin(); }
    match /office_config/{id}    { allow read: if signedIn(); allow write: if isAdmin(); }
    match /company_settings/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /recycle_bin/{id}      { allow read, write: if isAdmin(); }

    // only Admin can delete bills / leads / services
    // v42.3: a DELIVERED bill: only Admin can change its total or its items. Staff can still collect payments, add photos / bill number, etc.
    function sameBill() {
      return request.resource.data.get('totalAmount', null) == resource.data.get('totalAmount', null)
          && request.resource.data.get('items', null) == resource.data.get('items', null);
    }
    match /orders/{id} {
      allow read, create: if signedIn();
      allow update: if isAdmin() || resource.data.get('status', '') != 'Delivered' || sameBill();
      allow delete: if isAdmin();
    }
    match /leads/{id} { allow read, create, update: if signedIn(); allow delete: if isAdmin(); }
    match /services/{id} { allow read, create, update: if signedIn(); allow delete: if isAdmin(); }

    // everything else: any signed-in staff
    match /customers/{id} { allow read, write: if signedIn(); }
    match /inventory/{id} { allow read, write: if signedIn(); }
    match /machinery/{id} { allow read, write: if signedIn(); }
    match /machine_parts/{id} { allow read, write: if signedIn(); }
    match /quotations/{id} { allow read, write: if signedIn(); }
    match /travel_expenses/{id} { allow read, write: if signedIn(); }
    match /crm_records/{id} { allow read, write: if signedIn(); }
    match /catalog_categories/{id} { allow read, write: if signedIn(); }
    match /brands/{id} { allow read, write: if signedIn(); }
    match /expenses/{id} { allow read, write: if signedIn(); }
    match /overheads/{id} { allow read, write: if signedIn(); }
    match /activity/{id} { allow read, write: if signedIn(); }
    match /tasks/{id} { allow read, write: if signedIn(); }
    match /suppliers/{id} { allow read, write: if signedIn(); }
    match /purchases/{id} { allow read, write: if signedIn(); }
    match /purchase_bills/{id} { allow read, create, update: if signedIn(); allow delete: if isAdmin(); }
    match /attendance/{id} { allow read, write: if signedIn(); }
    match /leaves/{id} { allow read, write: if signedIn(); }
    match /events/{id} { allow read, write: if signedIn(); }
    match /notices/{id} { allow read, write: if signedIn(); }
    match /cash_closings/{id} { allow read, write: if signedIn(); }
    match /product_images/{id} { allow read, write: if signedIn(); }
    match /ai_jobs/{id} { allow read, write: if signedIn(); }
    match /team_messages/{id} { allow read, write: if signedIn(); }
    match /chat_status/{id} { allow read, write: if signedIn(); }
    match /app_notifications/{id} { allow read, write: if signedIn(); }
    match /fcm_tokens/{id} { allow read, write: if signedIn(); }
    match /counters/{id} { allow read, write: if signedIn(); }

    // v43: public share links. Anyone holding the long random token can GET that one document (cannot list or write); only staff publish / revoke.
    match /public_bills/{t}   { allow get: if true; allow list: if false; allow create, update, delete: if signedIn(); }
    match /public_portals/{t} { allow get: if true; allow list: if false; allow create, update, delete: if signedIn(); }

    // v43.3: customers tell us "I paid" from view.html. Anyone may CREATE one claim (strict shape, no read / edit / delete); only the Admin verifies or rejects.
    match /payment_claims/{id} {
      allow create: if request.resource.data.keys().hasOnly(['id','kind','tk','ord','name','amt','utr','by','at','status'])
        && request.resource.data.status == 'new' && request.resource.data.id == id
        && request.resource.data.utr is string && request.resource.data.utr.size() >= 6 && request.resource.data.utr.size() <= 30
        && request.resource.data.amt is number && request.resource.data.amt > 0 && request.resource.data.amt <= 10000000
        && request.resource.data.tk is string && request.resource.data.tk.size() <= 40
        && request.resource.data.by is string && request.resource.data.by.size() <= 60
        && request.resource.data.name is string && request.resource.data.name.size() <= 90
        && request.resource.data.ord is string && request.resource.data.ord.size() <= 60;
      allow read: if signedIn();
      allow update, delete: if isAdmin();
    }

    // v44: ONLINE STORE (shop.html). The catalogue is public by design (prices, photos, offers - no cost / dealer price, no customers).
    match /shop_catalog/{id} { allow get, list: if true; allow create, update, delete: if signedIn(); }
    match /shop_cat/{id}     { allow get, list: if true; allow create, update, delete: if signedIn(); }
    match /shop_img/{id}     { allow get: if true; allow list: if false; allow create, update, delete: if signedIn(); }
    match /shop_track/{id}   { allow get: if true; allow list: if false; allow create, update, delete: if signedIn(); }
    match /shop_users/{id}   { allow get: if true; allow list: if false; allow create, update: if request.resource.data.keys().hasOnly(["j","mob"]) && request.resource.data.j.size() < 60000; allow delete: if signedIn(); }
    match /shop_settings/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    // customers may only CREATE an order / enquiry (strict shape, size limits); staff read and update them
    match /shop_orders/{id} {
      allow read, update: if signedIn();
      allow delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['id','no','name','phone','email','addr','city','pin','state','gst','area','note','pay','utr','ij','sub','cdisc','coupon','ship','total','at','status'])
        && request.resource.data.id == id && request.resource.data.status == 'new'
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() == 10
        && request.resource.data.addr is string && request.resource.data.addr.size() <= 300
        && request.resource.data.ij is string && request.resource.data.ij.size() <= 6000
        && request.resource.data.total is number && request.resource.data.total > 0 && request.resource.data.total <= 5000000
        && request.resource.data.pay in ['upi','call'];
    }
    match /shop_enquiries/{id} {
      allow read, update: if signedIn();
      allow delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['id','pid','pn','name','phone','city','msg','at','status'])
        && request.resource.data.id == id && request.resource.data.status == 'new'
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() == 10
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 400;
    }

    match /{other=**} { allow read, write: if false; }
  }
}
